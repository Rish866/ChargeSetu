# Copy to .env.local (for your computer) or add in Vercel → Settings →
# Environment Variables (for the live site). Every variable is optional:
# with no Supabase settings, the app runs in DEMO MODE (fictional data).

# --- Supabase (enables the real database + accounts) ---
# Supabase dashboard → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" key (or the newer "publishable" key — either works).
# Safe for the browser: all access is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ Never add the service_role / secret key or the database password here.
# This app doesn't need them, and NEXT_PUBLIC_ values are visible to everyone.

# --- Site ---
# Your live address, no trailing slash. Used in emails, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Contact, Privacy and Terms pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Demo mode ---
# The demo "pick a role" sign-in only works on your own computer (npm run dev).
# On a deployed demo it is OFF unless you set this — only do that for private
# previews, because anyone could then act as an admin.
# ALLOW_DEMO_ROLES=true

# --- Map (optional) ---
# Set to "false" to hide the map and show the list only.
NEXT_PUBLIC_MAP_ENABLED=true
# Tile server. The default public OpenStreetMap tiles are for light use only
# (https://operations.osmfoundation.org/policies/tiles/). For a real launch,
# use a tile provider account, e.g. MapTiler, Stadia Maps or Thunderforest:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
