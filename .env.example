# Copy to .env.local and fill in. Every variable is optional:
# with nothing set, the app runs in DEMO MODE (fictional in-memory data,
# role picker instead of real sign-in).

# --- Supabase (enables the real database + authentication) ---
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" key (or the newer "publishable" key — either name works).
# Safe for the browser; all access is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ Never add the service-role / secret key here. This app does not need it,
# and any NEXT_PUBLIC_ variable is exposed to the browser.

# --- Site ---
# Used for auth email redirect links and metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Map (optional) ---
# Set to "false" to hide the map and show the list only.
NEXT_PUBLIC_MAP_ENABLED=true
# Tile server. Defaults to the public OpenStreetMap tiles, which are fine for
# development but have a usage policy — use a tile provider for production.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
