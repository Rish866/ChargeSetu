/**
 * Generates supabase/seed.sql from the fictional demo data so both modes show
 * the same sample stations. Run with:  npm run db:seed:generate
 * (Node >= 22.18 runs TypeScript files directly.)
 */
import { writeFileSync } from "node:fs";
import { demoReports, demoStations } from "../src/lib/data/demo-seed.ts";

const q = (v: string | null | undefined) => (v === null || v === undefined ? "null" : `'${v.replace(/'/g, "''")}'`);
const arr = (xs: string[]) => (xs.length ? `array[${xs.map(q).join(", ")}]::text[]` : "'{}'::text[]");
const num = (n: number | null) => (n === null ? "null" : String(n));

const stationRows = demoStations.map(
  (s) => `  (${[
    q(s.id),
    "null", // demo operators have no auth accounts, so seed stations are unowned
    q(s.name),
    q(s.slug),
    q(s.network),
    q(s.address),
    q(s.area),
    q(s.city),
    q(s.state),
    num(s.latitude),
    num(s.longitude),
    arr(s.connectorTypes),
    num(s.connectorCount),
    num(s.powerKw),
    num(s.price),
    q(s.priceUnit),
    q(s.openingHours),
    arr(s.amenities),
    q(s.contactPhone),
    q(`${s.status}`) + "::public.station_status",
    q(s.verificationStatus) + "::public.verification_status",
    "'demo'::public.station_source",
    q(s.rejectionReason),
    s.lastVerifiedAt ? `${q(s.lastVerifiedAt)}::timestamptz` : "null",
    `${q(s.createdAt)}::timestamptz`,
    `${q(s.updatedAt)}::timestamptz`,
  ].join(", ")})`,
);

const reportRows = demoReports.map(
  (r) =>
    `  (${[q(r.id), q(r.stationId), q(r.reporterEmail), q(r.issueType), q(r.description), `${q(r.status)}::public.report_status`, `${q(r.createdAt)}::timestamptz`].join(", ")})`,
);

const sql = `-- =============================================================================
-- ⚠️  FICTIONAL DEMO DATA — generated by scripts/generate-seed-sql.ts
-- Every station, network, address, phone number and price is invented.
-- Coordinates point at real neighbourhoods only so the map looks realistic.
-- These rows are marked source = 'demo' and the UI labels them "Demo data".
-- Do NOT load this into a production database presented as real data.
--
-- Remove later with:  delete from public.stations where source = 'demo';
-- =============================================================================

insert into public.stations (
  id, operator_id, name, slug, network, address, area, city, state,
  latitude, longitude, connector_types, connector_count, power_kw, price, price_unit,
  opening_hours, amenities, contact_phone, status, verification_status, source,
  rejection_reason, last_verified_at, created_at, updated_at
) values
${stationRows.join(",\n")}
on conflict (id) do nothing;

insert into public.reports (id, station_id, reporter_email, issue_type, description, status, created_at) values
${reportRows.join(",\n")}
on conflict (id) do nothing;
`;

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log(`Wrote supabase/seed.sql (${stationRows.length} stations, ${reportRows.length} reports)`);
